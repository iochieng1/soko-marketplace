# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml (non-default ports so PayBridge can run alongside)
DATABASE_URL=postgres://soko:soko@localhost:5433/soko
REDIS_URL=redis://localhost:6380

# Access-token signing key, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Seconds checkout holds stock for an unpaid order.
RESERVATION_TTL_SECONDS=600
# Seconds between sweeps that release stock from expired reservations.
RESERVATION_SWEEP_INTERVAL_SECONDS=60

# PayBridge (M-Pesa). Run PayBridge locally (it listens on :3000 by default),
# create a merchant and an API key there, and paste the key and webhook secret.
PAYBRIDGE_API_URL=http://localhost:3000
PAYBRIDGE_API_KEY=
PAYBRIDGE_WEBHOOK_SECRET=
# Least seconds between two PayBridge lookups for one order's status polls.
PAYBRIDGE_SYNC_INTERVAL_SECONDS=10

# Confirmation email (Resend) and SMS (Africa's Talking). Leave them empty to
# log messages instead of sending them (development only; in production
# unsent messages stay queued and are retried).
RESEND_API_KEY=
EMAIL_FROM=Soko <onboarding@resend.dev>
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=8
