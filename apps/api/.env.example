# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml (non-default ports so PayBridge can run alongside)
DATABASE_URL=postgres://soko:soko@localhost:5433/soko
REDIS_URL=redis://localhost:6380

# Access-token signing key, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
